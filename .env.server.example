# ---- Server binding ----
# 127.0.0.1 = local dev only. For the hosted web version set HOST=0.0.0.0 and
# run behind a TLS reverse proxy (Caddy/nginx). The server REFUSES to bind to
# a non-loopback address unless Supabase auth (below) is configured.
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=8787

# ---- API authentication (required for any hosted deployment) ----
# Same Supabase project the app uses. The server verifies each request's
# Bearer token against /auth/v1/user, and business-scoped routes are checked
# through the caller's own token so Supabase RLS decides membership.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Extra browser origins allowed to call the API, comma-separated.
# Same-origin (the server-hosted web app) and the Capacitor/Ionic app shells
# are always allowed; only add origins beyond those (e.g. a separate CDN host).
# ALLOWED_ORIGINS=https://app.example.com

# ---- Business email ----
EMAIL_CONFIG_SECRET=replace_with_a_long_random_secret

# ---- Magento POS ----
MAGENTO_BASE_URL=http://127.0.0.1:8080
MAGENTO_STORE_CODE=default
MAGENTO_ACCESS_TOKEN=replace_with_a_magento_integration_access_token

# ---- AI assistant (provider-agnostic) ----
# Swap providers/models by changing these — no code change. Leave LLM_API_KEY blank
# to keep AI features in deterministic mode (keyword matcher, rule-based scores).
# LLM_PROVIDER: "openai" (also any OpenAI-compatible gateway via LLM_BASE_URL) or "anthropic".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Point LLM_BASE_URL at any compatible endpoint, e.g.:
#   OpenAI       https://api.openai.com/v1
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://127.0.0.1:11434/v1
#   Anthropic    https://api.anthropic.com/v1   (with LLM_PROVIDER=anthropic)
LLM_BASE_URL=https://api.openai.com/v1
