# Existing BisaPilot server. Magento credentials remain in the root .env.server file.
BIZPILOT_API_URL=http://127.0.0.1:8787

# Required by the Next server for private procurement uploads. Never prefix this with NEXT_PUBLIC_.
# Set the matching project URL in SUPABASE_URL, or keep VITE_SUPABASE_URL in the root .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random characters. Signs short-lived HTTP-only employee sessions.
BIZPILOT_EMPLOYEE_SESSION_SECRET=
