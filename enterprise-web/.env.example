# Existing BisaPilot server. Magento credentials remain in the root .env.server file.
BIZPILOT_API_URL=http://127.0.0.1:8787

# Required by the Next server for private procurement + sales uploads. Never prefix this with NEXT_PUBLIC_.
# Set the matching project URL in SUPABASE_URL, or keep VITE_SUPABASE_URL in the root .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket that holds client POs and procurement documents (paths are namespaced by business +
# record so they share one bucket safely). Point at the per-environment bucket, e.g. documents_dev /
# documents_prod. Defaults to `documents` when unset.
SUPABASE_DOCUMENTS_BUCKET=documents

# At least 32 random characters. Signs short-lived HTTP-only employee sessions.
BIZPILOT_EMPLOYEE_SESSION_SECRET=
